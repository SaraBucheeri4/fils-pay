{$WEB_DOMAIN} {
  handle /v1/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

{$ADMIN_DOMAIN} {
  handle /v1/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv/admin
    try_files {path} /index.html
    file_server
  }
}
