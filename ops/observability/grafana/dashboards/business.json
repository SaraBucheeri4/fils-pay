    },
    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Empty means nothing here is firing. Each alert's runbook is in ops/observability/README.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"PaymentLinkMultipleCaptures|SettlementBatchMissing|WebhookBacklogStuck|ReportingOutboxLagging|BusinessMetricsMissing\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "instance": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "job": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 7
    },
